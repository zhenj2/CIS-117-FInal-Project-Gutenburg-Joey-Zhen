        # Search Section
        self.create_search_section(main_frame)
        
        # Add Book Section
        self.create_add_book_section(main_frame)
        
        # Results Section
        self.create_results_section(main_frame)
        
        # Status Bar
        self.status_var = tk.StringVar(value="Ready")
        status_bar = tk.Label(
            main_frame, 
            textvariable=self.status_var,
            bg=self.bg_color,
            fg=self.fg_color,
