import tkinter as tk
from tkinter import ttk, scrolledtext, messagebox
import sqlite3
import urllib.request
import urllib.error
import re
from collections import Counter


class GutenbergAnalyzer:
    """
    Main application class for the Project Gutenberg Book Analyzer.
    Handles GUI creation, database operations, web scraping, and word frequency analysis.
    """
    
    # List of common words to filter out
    STOP_WORDS = {
        'i', 'me', 'my', 'we', 'our', 'you', 'your', 'he', 'him', 'his', 'she', 
        'her', 'it', 'its', 'they', 'them', 'their', 'what', 'which', 'who', 
        'this', 'that', 'these', 'those', 'am', 'is', 'are', 'was', 'were', 
        'be', 'been', 'being', 'have', 'has', 'had', 'do', 'does', 'did', 
        'a', 'an', 'the', 'and', 'but', 'if', 'or', 'because', 'as', 'of', 
        'at', 'by', 'for', 'with', 'about', 'into', 'through', 'to', 'from', 
        'up', 'down', 'in', 'out', 'on', 'off', 'over', 'under', 'then', 
        'there', 'when', 'where', 'why', 'how', 'all', 'each', 'more', 'most', 
        'other', 'some', 'no', 'not', 'only', 'so', 'than', 'too', 'very', 
        'can', 'will', 'just', 'should', 'now'
    }
    
    def __init__(self, root):
        """
        Initialize the application with GUI components and database.
        
        Args:
            root: The tkinter root window
        """
        self.root = root
        self.root.title("Project Gutenberg Book Analyzer")
        self.root.geometry("850x650")
        
        # Set dark theme colors
        self.bg_color = '#1e1e1e'
        self.fg_color = '#e0e0e0'
        self.accent_color = '#0d7377'
        self.button_color = '#14a085'
        self.entry_bg = '#2d2d2d'
        
        # Configure root background
        self.root.configure(bg=self.bg_color)
        
        # Initialize database
        self.init_database()
        
        # Create GUI
        self.create_gui()
        
    def init_database(self):
        """
        Initialize the SQLite database and create table if it doesn't exist.
        Stores book titles and their top 10 most frequent words.
        """
        try:
            self.conn = sqlite3.connect('gutenberg_books.db')
            self.cursor = self.conn.cursor()
            
            # Check if table exists with old structure
            self.cursor.execute("SELECT name FROM sqlite_master WHERE type='table' AND name='books'")
            table_exists = self.cursor.fetchone()
            
            if table_exists:
                # Check if table has correct columns
                self.cursor.execute("PRAGMA table_info(books)")
                columns = [col[1] for col in self.cursor.fetchall()]
                
                # If old structure, drop and recreate
                if 'word1' not in columns:
                    self.cursor.execute("DROP TABLE books")
                    self.conn.commit()
            
            # Create single table for books and word frequencies
            self.cursor.execute('''
                CREATE TABLE IF NOT EXISTS books (
                    id INTEGER PRIMARY KEY AUTOINCREMENT,
                    title TEXT UNIQUE NOT NULL,
                    word1 TEXT, freq1 INTEGER,
                    word2 TEXT, freq2 INTEGER,
                    word3 TEXT, freq3 INTEGER,
                    word4 TEXT, freq4 INTEGER,
                    word5 TEXT, freq5 INTEGER,
                    word6 TEXT, freq6 INTEGER,
                    word7 TEXT, freq7 INTEGER,
                    word8 TEXT, freq8 INTEGER,
                    word9 TEXT, freq9 INTEGER,
                    word10 TEXT, freq10 INTEGER
                )
            ''')
            
            self.conn.commit()
        except sqlite3.Error as e:
            messagebox.showerror("Database Error", f"Failed to initialize database: {e}")
    
    def create_gui(self):
        """
        Create the graphical user interface with all components.
        Uses a dark theme with modern styling.
        """
